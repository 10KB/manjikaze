#!/bin/bash
set -e

# Screenshots like GNOME: saved to ~/Pictures/Screenshots and copied to the clipboard.
# Usage: manjikaze-hypr-screenshot [region|screen|window|rectangles]
#   region      drag an area, or click a window or screen; annotate it in Satty, Enter copies
#               and saves
#   screen      the focused monitor
#   window      the active window
#   rectangles  print the screens and visible windows for slurp

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
file="$dir/Screenshot from $(date +'%Y-%m-%d %H-%M-%S').png"

# Screens first, then the windows on each screen's visible workspaces. On a click, slurp picks
# the smallest box under the pointer: the window, or the screen when there is none.
rectangles() {
    local monitors
    monitors=$(hyprctl monitors -j)
    jq -r '.[] | select(.disabled | not)
        | (if .transform % 2 == 1 then [.height, .width] else [.width, .height] end) as [$w, $h]
        | "\(.x),\(.y) \($w / .scale | floor)x\($h / .scale | floor)"' <<<"$monitors"
    hyprctl clients -j | jq -r --argjson monitors "$monitors" '
        [$monitors[] | .activeWorkspace.id, .specialWorkspace.id] as $visible
        | .[] | select(.mapped and (.hidden | not) and (.workspace.id as $id | $visible | index($id)))
        | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

# Enter copies and saves; Escape closes without saving.
annotate() {
    satty --filename "$1" \
        --output-filename "$dir/Screenshot from %Y-%m-%d %H-%M-%S.png" \
        --copy-command wl-copy \
        --actions-on-enter save-to-clipboard \
        --save-after-copy \
        --actions-on-escape exit \
        --early-exit copy \
        --initial-tool arrow \
        --disable-notifications
}

finish() {
    wl-copy --type image/png <"$file"
    (
        if [[ "$(notify-send --app-name "Screenshot" --icon "$file" --action default=Annotate \
            "Screenshot saved" "Copied to the clipboard and saved to ${dir/#$HOME/\~}. Click to annotate.")" == "default" ]]; then
            annotate "$file"
        fi
    ) >/dev/null 2>&1 &
    disown
}

case "${1:-region}" in
    region)
        pkill slurp && exit 0
        mkdir -p "$dir"
        geometry=$(rectangles | slurp -d -b '#11151a88' -c '#3ddc97ff' -w 2) || exit 0
        grim -g "$geometry" - | annotate -
        ;;
    screen)
        mkdir -p "$dir"
        output=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
        grim -o "$output" "$file"
        finish
        ;;
    window)
        geometry=$(hyprctl activewindow -j | jq -r 'select(.at) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        [[ -n $geometry ]] || exit 0
        mkdir -p "$dir"
        grim -g "$geometry" "$file"
        finish
        ;;
    rectangles)
        rectangles
        ;;
    *)
        echo "Usage: $(basename "$0") [region|screen|window|rectangles]" >&2
        exit 1
        ;;
esac
