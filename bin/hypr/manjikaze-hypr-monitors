#!/bin/bash
set -e

# Remembers monitor layouts per combination of connected screens.
#
# Displays (nwg-displays) writes ~/.config/hypr/monitors.lua for whatever is connected at
# that moment. Hyprland doesn't load that file directly: this daemon stores its rules as the
# profile for the current set of screens, identified by make/model/serial so cables, docks
# and connector names don't matter. Whenever screens are (un)plugged, the matching profile
# is written to ~/.local/state/manjikaze/hypr/monitor-profile.lua, which manjikaze's
# monitors.lua loads. Unknown combinations fall back to automatic placement.
#
# The daemon also writes the active profile back to monitors.lua, so the file always
# describes the screens connected right now; when Displays reverts a change it restores
# exactly that.
#
# Usage: manjikaze-hypr-monitors [watch|sync|forget|list|reset]

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/manjikaze/hypr"
PROFILES="$STATE_DIR/monitor-profiles.json"
ACTIVE="$STATE_DIR/monitor-profile.lua"
CAPTURED="$STATE_DIR/monitors.lua.captured"
NWG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
NWG_FILE="$NWG_DIR/monitors.lua"
LIB_DIR="$(dirname "$(readlink -f "$0")")/lib"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/manjikaze-hypr-monitors.lock"

MONITOR_FIELDS='["output","mode","position","scale","transform","disabled","mirror","vrr","bitdepth","cm","sdr_eotf","sdrbrightness","sdrsaturation","supports_wide_color","supports_hdr","icc"]'

log() {
    echo "manjikaze-hypr-monitors: $*" >&2
}

lid_closed() {
    grep -qs closed /proc/acpi/button/lid/*/state
}

# Connected screens (including disabled and mirrored ones) with the identity used in rules:
# "desc:<make model serial>" when unique, otherwise the connector name.
connected_monitors() {
    hyprctl monitors all -j | jq '
        (map(.description) | group_by(.) | map(select(length == 1) | .[0])) as $unique
        | map({
            name,
            internal: (.name | test("^(eDP|LVDS|DSI)")),
            id: (if (.description != "" and (.description | IN($unique[]))) then "desc:" + .description else .name end)
        })'
}

profile_key() {
    jq -r 'map(.id) | sort | join(" | ")' <<<"$1"
}

# Store the rules Displays just wrote as the profile for the connected screens. Files that
# don't describe exactly these screens (a revert to a layout from another desk) are ignored.
capture() {
    local monitors="$1" key="$2" closed=false rules

    lid_closed && closed=true
    rules=$(lua "$LIB_DIR/monitor-rules-to-json.lua" "$NWG_FILE" | jq --argjson monitors "$monitors" \
        --argjson fields "$MONITOR_FIELDS" --argjson closed "$closed" '
        def identity($output):
            if ($output | startswith("desc:")) then ($monitors | map(select(.id == $output)) | first | .id) // null
            else ($monitors | map(select(.name == $output)) | first | .id) // null end;
        map(with_entries(select(.key | IN($fields[]))))
        | map(.output = identity(.output // ""))
        | map(if .mirror then .mirror = (identity(.mirror) // .mirror) else . end)
        | if any(.[]; .output == null) or ((map(.output) | unique) != (if length == 0 then [] else ($monitors | map(.id) | unique) end))
          then null
          # With the lid closed the panel is off because of the lid, not because of the layout.
          else map(select(($closed and .disabled == true and (.output as $o | $monitors | any(.id == $o and .internal))) | not))
          end')

    if [[ $rules == "null" ]]; then
        log "monitors.lua doesn't match the connected screens, not saving it"
        return 0
    fi

    [[ -f $PROFILES ]] || echo '{}' >"$PROFILES"
    if [[ $(jq 'length' <<<"$rules") -eq 0 ]]; then
        jq --arg key "$key" 'del(.[$key])' "$PROFILES" >"$PROFILES.tmp"
        log "automatic layout for: $key"
    else
        jq --arg key "$key" --argjson rules "$rules" --arg saved "$(date --iso-8601=seconds)" \
            '.[$key] = { rules: $rules, saved: $saved }' "$PROFILES" >"$PROFILES.tmp"
        log "saved layout for: $key"
    fi
    mv "$PROFILES.tmp" "$PROFILES"
}

profile_rules() {
    if [[ -f $PROFILES ]]; then
        jq -c --arg key "$1" '.[$key].rules // []' "$PROFILES"
    else
        echo '[]'
    fi
}

render_profile() {
    local key="$1"

    echo "-- Generated by manjikaze-hypr-monitors; arrange screens with Displays (SUPER + P) instead."
    jq -r --arg key "$key" '
        def lua: if type == "string" then tojson else tostring end;
        "return {",
        "  key = \($key | tojson),",
        "  rules = {",
        (.[] | "    { " + (to_entries | map("\(.key) = \(.value | lua)") | join(", ")) + " },"),
        "  },",
        "}"' <<<"$(profile_rules "$key")"
}

# The same rules in the form Displays writes, as the baseline it backs up and restores.
write_displays_file() {
    local key="$1"

    mkdir -p "$NWG_DIR"
    {
        echo "-- Layout for: $key"
        echo "-- Managed by Displays (SUPER + P) and manjikaze-hypr-monitors; Hyprland doesn't load this file."
        jq -r '
            def lua: if type == "string" then tojson else tostring end;
            .[] | "hl.monitor({ " + (to_entries | map("\(.key) = \(.value | lua)") | join(", ")) + " })"' <<<"$(profile_rules "$key")"
    } >"$NWG_FILE.tmp"
    mv "$NWG_FILE.tmp" "$NWG_FILE"
    cp "$NWG_FILE" "$CAPTURED"
}

sync() {
    local monitors key rendered

    mkdir -p "$STATE_DIR"
    monitors=$(connected_monitors) || {
        log "could not query Hyprland"
        return 0
    }
    [[ $(jq 'length' <<<"$monitors") -gt 0 ]] || return 0
    key=$(profile_key "$monitors")

    # Without a baseline (first run) the file may come from another desk; don't trust it.
    if [[ -f $NWG_FILE && -f $CAPTURED ]] && ! cmp -s "$NWG_FILE" "$CAPTURED"; then
        capture "$monitors" "$key"
    fi

    rendered=$(render_profile "$key")
    if [[ "$rendered" != "$(cat "$ACTIVE" 2>/dev/null)" ]]; then
        printf '%s\n' "$rendered" >"$ACTIVE.tmp"
        mv "$ACTIVE.tmp" "$ACTIVE"
        write_displays_file "$key"
        log "applying layout for: $key"
        hyprctl reload >/dev/null
    elif ! cmp -s "$NWG_FILE" "$CAPTURED"; then
        write_displays_file "$key"
    fi
}

locked_sync() {
    (
        flock 9
        sync
    ) 9>"$LOCK"
}

watch_hyprland() {
    local socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

    socat -U - "UNIX-CONNECT:$socket" | while read -r event; do
        case "$event" in
            monitoraddedv2\>\>* | monitorremovedv2\>\>*)
                sleep 0.5
                locked_sync
                ;;
        esac
    done
}

watch_displays_tool() {
    mkdir -p "$NWG_DIR"
    inotifywait -m -q -e close_write,moved_to --format '%f' "$NWG_DIR" | while read -r file; do
        if [[ $file == "monitors.lua" ]]; then
            locked_sync
        fi
    done
}

case "${1:-watch}" in
    watch)
        if [[ -z $HYPRLAND_INSTANCE_SIGNATURE ]]; then
            log "not running inside Hyprland"
            exit 1
        fi
        locked_sync
        watch_hyprland &
        watch_displays_tool &
        # Exit when either watcher dies so systemd restarts the pair.
        wait -n
        exit 1
        ;;
    sync)
        locked_sync
        ;;
    forget)
        monitors=$(connected_monitors)
        key=$(profile_key "$monitors")
        if [[ -f $PROFILES ]]; then
            jq --arg key "$key" 'del(.[$key])' "$PROFILES" >"$PROFILES.tmp"
            mv "$PROFILES.tmp" "$PROFILES"
        fi
        log "forgot layout for: $key"
        locked_sync
        ;;
    list)
        [[ -f $PROFILES ]] && jq -r 'to_entries[] | "\(.value.saved)  \(.key)"' "$PROFILES"
        ;;
    reset)
        rm -f "$ACTIVE"
        ;;
    *)
        echo "Usage: $(basename "$0") [watch|sync|forget|list|reset]" >&2
        exit 1
        ;;
esac
