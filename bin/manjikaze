#!/bin/bash
set -e

# Determine the actual script path regardless of symlinks
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")

# Default installation directory
DEFAULT_MANJIKAZE_DIR="$HOME/.manjikaze"

# Check if we're running from the default installation directory
if [[ "$SCRIPT_DIR" != "$DEFAULT_MANJIKAZE_DIR/bin" ]]; then
    # A package install or a development checkout - use the parent of the script directory
    export MANJIKAZE_DIR=$(dirname "$SCRIPT_DIR")
else
    export MANJIKAZE_DIR="$DEFAULT_MANJIKAZE_DIR"
fi

source "$MANJIKAZE_DIR/lib/common.sh"

if [[ "$MANJIKAZE_DIR" == "$DEFAULT_MANJIKAZE_DIR" ]] || is_package_install; then
    export DEV_MODE=false
else
    export DEV_MODE=true
fi

source "$MANJIKAZE_DIR/lib/state.sh"
source "$MANJIKAZE_DIR/lib/setup.sh"
source "$MANJIKAZE_DIR/lib/migrations.sh"
source "$MANJIKAZE_DIR/lib/update.sh"
source "$MANJIKAZE_DIR/lib/audits.sh"
source "$MANJIKAZE_DIR/lib/menus.sh"

check_updates() {
    if [ -d "$MANJIKAZE_DIR/.git" ] && [ "$DEV_MODE" = false ]; then
        status "Checking for Manjikaze updates..."
        git -C "$MANJIKAZE_DIR" fetch origin >/dev/null 2>&1
        local_rev=$(git -C "$MANJIKAZE_DIR" rev-parse HEAD)
        remote_rev=$(git -C "$MANJIKAZE_DIR" rev-parse @{u})
        if [ "$local_rev" != "$remote_rev" ]; then
            if [[ ${UPDATE_UNATTENDED:-false} == true ]] || gum confirm "Updates available. Would you like to update Manjikaze?"; then
                if ! git -C "$MANJIKAZE_DIR" pull --ff-only; then
                    # An unattended update never discards local changes.
                    if [[ ${UPDATE_UNATTENDED:-false} == true ]]; then
                        status "Could not update Manjikaze in $MANJIKAZE_DIR, so the update goes on with the version that is there."
                        return 0
                    fi

                    if git -C "$MANJIKAZE_DIR" diff --quiet HEAD; then
                        status "Update failed. Please resolve conflicts in $MANJIKAZE_DIR and try again."
                        exit 1
                    fi

                    if gum confirm "Update failed due to local changes. Would you like to discard local changes and force update?"; then
                        status "Discarding local changes and forcing update..."
                        git -C "$MANJIKAZE_DIR" reset --hard HEAD >/dev/null 2>&1
                        git -C "$MANJIKAZE_DIR" pull --ff-only
                        exec "$0" "$@"
                    else
                        status "Update cancelled. Please commit or stash your changes in $MANJIKAZE_DIR."
                        exit 1
                    fi
                else
                    exec "$0" "$@"
                fi
            fi
        fi
    fi
}

check_prerequisites() {
    status "Checking system prerequisites..."
    local prerequisites=(archlinux-keyring base-devel git gum jq yay)
    local to_install=()

    for pkg in "${prerequisites[@]}"; do
        if ! is_installed "$pkg"; then
            to_install+=("$pkg")
        fi
    done

    if [ ${#to_install[@]} -ne 0 ]; then
        status "Installing prerequisites: ${to_install[*]}..."
        sudo pacman -Sy "${to_install[@]}" --noconfirm --noprogressbar --quiet
    fi
}

show_header() {
    local title="Manjikaze $(get_version)"
    local subtitle="10KB Development Environment"

    if [ "$DEV_MODE" = true ]; then
        title="$title [DEVELOPMENT MODE]"
        subtitle="$subtitle (path: $MANJIKAZE_DIR)"
    fi

    gum style \
        --border double \
        --align center \
        --width 70 \
        --margin "1 2" \
        --padding "1 2" \
        "$title" \
        "$subtitle"
}

# manjikaze migrate runs the pending migrations without asking.
# manjikaze migrate --pending prints them, and exits 1 when there are none.
# manjikaze migrate --notify shows a notice when there are any, for the service after login.
migrate_command() {
    local pending
    pending=$(pending_migrations)

    case "${1:-}" in
        --pending)
            if [[ -z "$pending" ]]; then
                return 1
            fi
            echo "$pending"
            ;;
        --notify)
            if [[ -n "$pending" ]]; then
                notify_pending_migrations "$(wc -l <<< "$pending")"
            fi
            ;;
        "")
            if [[ -z "$pending" ]]; then
                status "No pending migrations."
                return 0
            fi
            status "Requesting administrator privileges for system commands..."
            sudo -v
            start_sudo_keepalive
            run_migrations --yes
            ;;
        *)
            echo "Usage: manjikaze migrate [--pending | --notify]" >&2
            return 2
            ;;
    esac
}

main() {
    # Ensure the sudo keep-alive is always cleaned up, even on unexpected exit.
    trap 'stop_sudo_keepalive' EXIT

    # Runs before anything reads the state file
    setup_package_install
    mark_migrations_done_on_new_install

    if [[ "$1" == "setup" ]]; then
        exit 0
    fi

    if [[ "$1" == "migrate" ]]; then
        shift
        migrate_command "$@"
        exit
    fi

    if [[ "$1" == "firmware" ]]; then
        clear
        show_header
        source "$MANJIKAZE_DIR/app/installations/update-firmware.sh"
        exit
    fi

    if [[ "$1" == "update" ]]; then
        # -y updates everything without asking, for a timer or a remote request. sudo still asks
        # for a password once when it needs one.
        case "${2:-}" in
            -y | --yes) UPDATE_UNATTENDED=true ;;
            "") ;;
            *)
                echo "Usage: manjikaze update [-y]" >&2
                exit 2
                ;;
        esac

        # Every update leaves a log. script records the terminal, questions included, while the
        # update runs inside it, and exits with the update's exit code.
        if [[ -z ${MANJIKAZE_UPDATE_LOG:-} ]] && command -v script > /dev/null; then
            local log command
            if log=$(new_update_log); then
                export MANJIKAZE_UPDATE_LOG=$log
                # script runs the command with $SHELL, which the command sets back for the update.
                printf -v command 'export SHELL=%q; exec %s' "${SHELL:-/bin/bash}" "$(printf '%q ' "$0" "$@")"
                exec env SHELL=/bin/bash script -qefc "$command" "$log"
            fi
            status "Could not create a log in $UPDATE_LOG_DIR, so this update isn't logged."
        fi

        clear
        show_header

        status "Requesting administrator privileges for system commands..."
        sudo -v
        start_sudo_keepalive

        # First update manjikaze itself
        check_updates "$@"

        # The update runs the migrations after the system packages, which may include Manjikaze.
        source "$MANJIKAZE_DIR/app/installations/update-installed-apps.sh"
        exit 0
    fi

    clear
    show_header

    status "Requesting administrator privileges for system commands..."
    sudo -v
    start_sudo_keepalive

    check_updates "$@"

    check_prerequisites

    run_migrations || status "Migration check/run finished with errors or cancellation."

    run_audits || status "Audit check/run finished with errors or cancellation."

    # Stop the keep-alive before entering the interactive menu.
    stop_sudo_keepalive

    clear
    show_header

    handle_menu menu "Main Menu"
}

main "$@"

