// Waybar for Manjikaze's Hyprland session. No "output" is set, so every connected monitor
// gets a bar without naming monitors anywhere.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "group/system"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Apps (Super + Space)\nRight click: settings (Super + I)",
    "on-click": "manjikaze-hypr-launcher",
    "on-click-right": "manjikaze-hypr-menu settings"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "",
    "on-scroll-down": "",
    "show-special": false
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "today": "<span color='#3ddc97'><b>{}</b></span>",
        "weeks": "<span color='#8b98a5'>W{}</span>"
      }
    },
    "on-click": "swaync-client --toggle-panel --skip-wait"
  },

  // The network and Bluetooth applets only run for their password and pairing prompts; the
  // system menu next to the tray shows their status.
  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "ignore-list": ["nm-applet", "blueman"]
  },

  // Status icons in one button, like GNOME's system menu. A click opens quick settings and
  // notifications (swaync); right click goes straight to the matching list. Icons that have
  // nothing to report (one keyboard layout, Bluetooth without a device, no notifications)
  // stay hidden.
  "group/system": {
    "orientation": "inherit",
    "modules": [
      "custom/keyboard",
      "custom/stay-awake",
      "network",
      "bluetooth",
      "pulseaudio",
      "battery",
      "custom/notifications"
    ]
  },

  "custom/keyboard": {
    "exec": "manjikaze-hypr-keyboard-layout",
    "return-type": "json",
    "on-click": "hyprctl switchxkblayout all next"
  },

  "custom/stay-awake": {
    "exec": "manjikaze-hypr-stay-awake waybar",
    "return-type": "json",
    "interval": 60,
    "signal": 9,
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "manjikaze-hypr-stay-awake off"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈂",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\nRight click: Wi-Fi networks",
    "tooltip-format-ethernet": "{ifname} {ipaddr}\nRight click: Wi-Fi networks",
    "tooltip-format-disconnected": "Disconnected\nRight click: Wi-Fi networks",
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "manjikaze-hypr-menu wifi"
  },

  "bluetooth": {
    "format": "",
    "format-off": "",
    "format-disabled": "",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format-connected": "{device_enumerate}\nRight click: Bluetooth devices",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "manjikaze-hypr-launcher -m bluetooth"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}: {volume}%\nScroll: volume  ·  Right click: sound devices  ·  Middle click: mute",
    "scroll-step": 5,
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "manjikaze-hypr-launcher -m wireplumber",
    "on-click-middle": "swayosd-client --output-volume mute-toggle"
  },

  "battery": {
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "tooltip-format": "{capacity}% · {timeTo}",
    "on-click": "swaync-client --toggle-panel --skip-wait"
  },

  "custom/notifications": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='#3ddc97'><sup></sup></span>",
      "none": "",
      "dnd-notification": "󰂛<span foreground='#3ddc97'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#3ddc97'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "󰂛<span foreground='#3ddc97'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client --subscribe-waybar",
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "swaync-client --toggle-dnd --skip-wait",
    "escape": true
  }
}
