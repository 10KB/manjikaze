[Unit]
Description=Manjikaze Hyprland session services
Documentation=https://manjikaze.10kb.nl/features/hyprland
# Started by Hyprland itself (manjikaze/autostart.lua) and deliberately not enabled for
# graphical-session.target: GNOME reaches that target too, and a failed condition here
# would not stop the units below from starting.
PartOf=graphical-session.target
After=graphical-session.target
Wants=hyprpolkitagent.service
Wants=manjikaze-hypr-monitors.service
Wants=manjikaze-elephant.service manjikaze-walker.service
Wants=hypridle.service hyprpaper.service
Wants=waybar.service swaync.service manjikaze-swayosd.service
# 10KB tools with a Hyprland front end (tray icon, approval cards); skipped when not installed.
Wants=42kb-ui.service host-gate-overlay.service
